# Copy this file to .env and fill in values as needed.
# Only PUBLIC, client-safe values belong here. Never put secret/service-role
# keys in a Vite .env file — anything prefixed VITE_ is bundled into the
# frontend and visible to anyone who views source.

# Optional: a Formspree (https://formspree.io) form endpoint for the contact
# form, e.g. https://formspree.io/f/abcdwxyz. Formspree's endpoint is meant
# to be called directly from the browser, so this is safe to expose.
# Leave unset and the contact form falls back to opening the visitor's
# email client with the message pre-filled (see src/lib/contact.ts).
VITE_FORMSPREE_ENDPOINT=
